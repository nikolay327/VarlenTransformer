# Normalize text files and keep source/config files as LF.
* text=auto

*.py   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.sh   text eol=lf

.gitignore text eol=lf
LICENSE    text eol=lf

# Windows-native scripts, if we ever add any.
*.bat text eol=crlf
*.cmd text eol=crlf